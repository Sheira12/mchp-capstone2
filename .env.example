APP_NAME="MHC Parish System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mhc_parish
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ──────────────────────────────────────────────────────────────────
# SUPABASE STORAGE (persistent media storage — required on Render)
# ──────────────────────────────────────────────────────────────────
# Render's filesystem is EPHEMERAL — files in storage/app/public/
# are wiped on every redeploy. All media (images, PDFs, QR codes)
# must be stored in Supabase Storage to survive redeploys.
#
# Setup steps:
#   1. Go to your Supabase project → Storage → Create a bucket
#      Bucket name: mhcp-media
#      Make it PUBLIC (so images load without signed URLs)
#   2. Go to Project Settings → API → copy the "service_role" JWT
#      (not the anon key — the service_role key is needed for uploads)
#   3. Find your project URL: https://{your-ref}.supabase.co
#   4. Find your region in Project Settings → Infrastructure
#      (usually ap-southeast-1 for Southeast Asia projects)
#   5. Set all four variables below in Render → Environment tab
#
# SUPABASE_URL          = https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_STORAGE_KEY  = your_service_role_jwt_here
# SUPABASE_BUCKET       = mhcp-media
# SUPABASE_REGION       = ap-southeast-1
#
# After deploying, run this once in Render terminal to migrate any
# remaining local files and identify orphaned DB rows:
#   php artisan storage:migrate-to-supabase
# ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_KEY=your_service_role_jwt_here
SUPABASE_BUCKET=mhcp-media
SUPABASE_REGION=ap-southeast-1

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password-no-spaces
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-gmail@gmail.com"
MAIL_FROM_NAME="MHC Parish System"

# SMS via Semaphore (Philippine SMS Gateway)
# 1. Sign up free at https://semaphore.co
# 2. Go to Account > API Keys and copy your key
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=MHCParish

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Payment Gateways
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret_here

PAYMONGO_SUCCESS_URL=http://127.0.0.1:8000/payment/success
PAYMONGO_CANCEL_URL=http://127.0.0.1:8000/payment/cancel

# LOCAL DEV ONLY: PayMongo's server cannot reach your LAN IP (127.0.0.1 / 192.168.x.x).
# Set this to your deployed Render/production URL when you need to test the
# GCash/Maya redirect flow locally with real PayMongo TEST keys.
# Leave empty on Render — APP_URL is used there automatically.
PAYMONGO_RETURN_URL_BASE=

# QR Code
QR_VERIFICATION_BASE_URL="${APP_URL}/verify"

# Parish Info
PARISH_NAME="Mary Help of Christians Parish"
PARISH_ADDRESS="Southville 1, Niugan, Cabuyao, Laguna"
PARISH_PHONE="+63 49 XXX XXXX"
PARISH_EMAIL="mhcparish@gmail.com"
PARISH_PRIEST="Rev. Fr. [Parish Priest Name]"
